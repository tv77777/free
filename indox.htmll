    <!-- ========== من نحن ========== -->
    <section class="about-section" id="about">
        <div class="container">
            <div class="about-grid">
                <div class="about-images">
                    <div class="about-img-main">
                        <img src="https://i.postimg.cc/WbbcSt1t/IMG-20260624-WA0029.jpg" alt="أعمال الترميم والتشطيب">
                    </div>
                    <div class="about-img-sub">
                        <img src="https://i.postimg.cc/7ZRCwpWV/IMG-20260624-WA0018.jpg" alt="دهانات خارجية">
